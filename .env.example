# Qdrant vector database URL
QDRANT_URL=http://localhost:6333

# Ollama model to use for answer generation
OLLAMA_MODEL=gemma3

# Minimum similarity score (0.0–1.0) for a retrieved chunk to be used
SCORE_THRESHOLD=0.4

# Sentence-transformers model used for embeddings (re-index after changing this)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector size of the embedding model (must match EMBEDDING_MODEL; re-index after changing)
EMBEDDING_VECTOR_SIZE=384

# Cross-encoder model used to rerank retrieved chunks before answering
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Set to false to disable reranking and use raw vector-search order
RERANK_ENABLED=true

# Number of candidates fetched from Qdrant before reranking down to the request limit
RETRIEVAL_CANDIDATES=25

# Optional: inline extra context appended to the system prompt (e.g. product info, identity)
DEVPILOT_EXTRA_CONTEXT=

# Optional: path to a file whose contents are used as extra context (takes precedence over DEVPILOT_EXTRA_CONTEXT)
DEVPILOT_EXTRA_CONTEXT_FILE=

# Optional: fully override the default system prompt for all requests
DEVPILOT_SYSTEM_PROMPT=

# API base URL used by the CLI
DEVPILOT_URL=http://127.0.0.1:8000

# Braintrust API key — required to upload eval results to app.braintrust.dev
# Sign up free at https://app.braintrust.dev, then go to Settings → API Keys
BRAINTRUST_API_KEY=
